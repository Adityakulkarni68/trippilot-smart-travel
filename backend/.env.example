# Database configuration — SQLite by default for instant local dev, or PostgreSQL for production
DATABASE_URL=sqlite:///./navigen.db
# DATABASE_URL=postgresql://travel_user:travel_pass@localhost:5432/travel_planner

SECRET_KEY=replace-with-a-strong-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional external API keys — app uses built-in resilient datasets & realistic models without them
GOOGLE_PLACES_API_KEY=
GEOAPIFY_API_KEY=
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
ORS_API_KEY=
